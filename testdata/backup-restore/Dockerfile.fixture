# syntax=docker/dockerfile:1

FROM golang:1.25-alpine@sha256:3eb6c2b3db8d55e38537302edb510b4417f8a115efbd5906d131ceba9468e29a AS build
WORKDIR /src
COPY fixture.go ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/fixture fixture.go

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
COPY --from=build /out/fixture /usr/local/bin/n0ding-drill-fixture
USER 65532:65532
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/n0ding-drill-fixture"]
